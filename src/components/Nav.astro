<nav id="main-nav">
  <div id="scroll-progress"></div>
  <div class="container nav-inner">
    <a href="#hero" class="logo">
      <span class="logo-text">Javi</span>
      <span class="logo-accent">GT97</span>
    </a>

    <button class="hamburger" id="hamburger" aria-label="Abrir menú">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-links" id="nav-links">
      <a href="#sobre-mi" class="nav-link" data-section="Sobre mí">Sobre mí</a>
      <a href="#habilidades" class="nav-link" data-section="Habilidades">Habilidades</a>
      <a href="#proyectos" class="nav-link" data-section="Proyectos">Proyectos</a>
      <a href="#trayectoria" class="nav-link" data-section="Trayectoria">Trayectoria</a>
      <a href="#certificados" class="nav-link" data-section="Certificados">Certificados</a>
      <a href="#contacto" class="nav-link" data-section="Contacto">Contacto</a>
    </div>

    <div class="nav-indicator" id="nav-indicator"></div>
  </div>
</nav>

<script>
  // Mobile nav + indicator - single source of truth
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  const indicator = document.getElementById('nav-indicator');
  const navLinksArr = navLinks ? Array.from(navLinks.querySelectorAll('.nav-link')) : [];

  const logo = document.querySelector('.logo');

  function animateNavIndicator(activeIndex = 0) {
    if (!indicator || navLinks.classList.contains('open')) return;
    const innerRect = document.querySelector('.nav-inner').getBoundingClientRect();
    if (activeIndex === 0) {
      const logoRect = logo.getBoundingClientRect();
      indicator.style.left = `${logoRect.left - innerRect.left}px`;
      indicator.style.width = `${logoRect.width}px`;
    } else {
      const activeLink = navLinksArr[activeIndex - 1];
      if (!activeLink) return;
      const linkRect = activeLink.getBoundingClientRect();
      indicator.style.left = `${linkRect.left - innerRect.left}px`;
      indicator.style.width = `${linkRect.width}px`;
    }
    indicator.style.opacity = '1';
  }

  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      navLinks.classList.toggle('open');
      document.body.classList.toggle('nav-open');
      if (navLinks.classList.contains('open')) {
        indicator.style.opacity = '0';
      }
    });

    navLinks.querySelectorAll('.nav-link').forEach((link, index) => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('active');
        navLinks.classList.remove('open');
        document.body.classList.remove('nav-open');
        requestAnimationFrame(() => animateNavIndicator(index + 1));
      });
    });

    if (logo) {
      logo.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        requestAnimationFrame(() => animateNavIndicator(0));
      });
    }

    let currentSectionIndex = 0;
    const sections = document.querySelectorAll('section[id]');

    const updateNavIndicator = () => {
      let newIndex = currentSectionIndex;
      const scrollPosition = window.scrollY + 160;
      sections.forEach((section, index) => {
        if (section.offsetTop <= scrollPosition) newIndex = index;
      });
      if (newIndex !== currentSectionIndex) {
        currentSectionIndex = newIndex;
        animateNavIndicator(newIndex);
      }
    };

    window.addEventListener('scroll', updateNavIndicator, { passive: true });
    requestAnimationFrame(() => animateNavIndicator());
  }

  // Nav shrink on scroll
  const nav = document.getElementById('main-nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 80);
    }, { passive: true });
  }
</script>

