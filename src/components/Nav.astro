    .nav-links.open .nav-link:nth-child(3) { transition-delay: 0.16s; }
    .nav-links.open .nav-link:nth-child(4) { transition-delay: 0.20s; }
    .nav-links.open .nav-link:nth-child(5) { transition-delay: 0.24s; }
    .nav-links.open .nav-link:nth-child(6) { transition-delay: 0.28s; }

    .nav-indicator { display: none; }

    .nav-link.active {
      color: var(--accent-primary);
      background: linear-gradient(90deg, rgba(0, 212, 170, 0.08), transparent);
    }

    .nav-link:hover {
      color: var(--accent-primary);
      padding-left: var(--space-2);
    }
  }
</style>
