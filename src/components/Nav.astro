<nav>
  <div id="scroll-progress"></div>
  <div class="container nav-inner">
    <a href="#hero" class="logo">
      <span class="logo-bracket">&lt;</span>JG<span class="logo-bracket">/&gt;</span>
    </a>
    <button class="hamburger" id="hamburger" aria-label="Menú de navegación">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nav-links" id="nav-links">
      <a href="#about" class="nav-link">Sobre mí</a>
      <a href="#skills" class="nav-link">Skills</a>
      <a href="#projects" class="nav-link">Proyectos</a>
      <a href="#timeline" class="nav-link">Trayectoria</a>
      <a href="#certificates" class="nav-link">Certificados</a>
      <a href="#contact" class="nav-link nav-cta">Contactar</a>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.getElementById("hamburger");
  const navLinks = document.getElementById("nav-links");

  if (hamburger && navLinks) {
    hamburger.addEventListener("click", () => {
      hamburger.classList.toggle("active");
      navLinks.classList.toggle("open");
      document.body.classList.toggle("nav-open");
    });

    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        hamburger.classList.remove("active");
        navLinks.classList.remove("open");
        document.body.classList.remove("nav-open");
      });
    });
  }
</script>

