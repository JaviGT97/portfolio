<script>
  const wordsES = ["Full Stack", "de Software", "Backend", "Frontend", "Multiplataforma"];
  const wordsEN = ["Full Stack", "Software", "Backend", "Frontend", "Cross-Platform"];
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const el = document.getElementById("typing");

  function getWords() {
    return document.documentElement.lang === 'en' ? wordsEN : wordsES;
  }

  function typeEffect() {
    if (!el) return;
    const words = getWords();
    const current = words[wordIndex % words.length];
    if (!isDeleting) {
      el.textContent = current.substring(0, charIndex + 1);
      charIndex++;
      if (charIndex === current.length) {
        isDeleting = true;
        setTimeout(typeEffect, 2200);
        return;
      }
      setTimeout(typeEffect, 75);
    } else {
      el.textContent = current.substring(0, charIndex - 1);
      charIndex--;
      if (charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        setTimeout(typeEffect, 350);
        return;
      }
      setTimeout(typeEffect, 35);
    }
  }

  if (document.readyState === "complete") typeEffect();
  else window.addEventListener("load", typeEffect);
</script>

