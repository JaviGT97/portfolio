      </div>
      <div class="metric-divider"></div>
      <div class="metric">
        <span class="metric-value">Java</span>
        <span class="metric-label">Principal lenguaje</span>
      </div>
      <div class="metric-divider"></div>
      <div class="metric">
        <span class="metric-value">2020</span>
        <span class="metric-label">Empecé en dev</span>
      </div>
    </div>
  </div>
