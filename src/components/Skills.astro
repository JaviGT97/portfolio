---
const categories = [
  {
    name: "skills.langs",
    nameDefault: "Lenguajes",
    color: "#00d4aa",
    icon: "{ }",
    skills: [
      { name: "Java", pct: 88 },
      { name: "Kotlin", pct: 82 },
      { name: "JavaScript", pct: 90 },
      { name: "Python", pct: 72 },
      { name: "TypeScript", pct: 68 },
    ],
  },
  {
    name: "skills.frameworks",
    nameDefault: "Frameworks & Libs",
    color: "#38bdf8",
    icon: "</>",
    skills: [
      { name: "Astro", pct: 80 },
      { name: "React", pct: 70 },
      { name: "Next.js", pct: 65 },
      { name: "Node.js", pct: 78 },
      { name: "Django", pct: 60 },
    ],
  },
  {
    name: "skills.databases",
    nameDefault: "Bases de datos",
    color: "#7c5cff",
    icon: "=/",
    skills: [
      { name: "MySQL", pct: 80 },
      { name: "PostgreSQL", pct: 70 },
      { name: "MongoDB", pct: 60 },
      { name: "Supabase", pct: 65 },
      { name: "SQLite", pct: 75 },
    ],
  },
  {
    name: "skills.tools",
    nameDefault: "Herramientas",
    color: "#f59e0b",
    icon: "⚙",
    skills: [
      { name: "Git", pct: 88 },
      { name: "GitHub", pct: 88 },
      { name: "Vercel", pct: 75 },
      { name: "GitHub Actions", pct: 70 },
      { name: "IntelliJ IDEA", pct: 82 },
    ],
  },
];
---

<section id="habilidades">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="skills.label">Habilidades</span>
      <h2 class="section-title">
        <span data-i18n="skills.title">Mi stack</span> <span class="gradient-text" data-i18n="skills.title.hl">tecnológico</span>
      </h2>
      <p class="section-desc" data-i18n="skills.desc">Tecnologías y herramientas que domino para construir soluciones completas de extremo a extremo.</p>
    </div>

    <div class="skills-grid">
      {categories.map((cat, ci) => (
        <div class="skill-card reveal" style={`--cat-color: ${cat.color}; transition-delay: ${0.1 * ci}s;`}>
          <div class="skill-card-glow"></div>
          <div class="skill-card-header">
            <span class="cat-icon mono">{cat.icon}</span>
            <div>
              <h3 class="cat-name" data-i18n={cat.name}>{cat.nameDefault}</h3>
              <span class="cat-count">{cat.skills.length} tecnologías</span>
            </div>
          </div>
          <div class="skill-tags">
            {cat.skills.map((s) => (
              <div class="skill-tag" style={`--skill-pct: ${s.pct}%`}>
                <div class="skill-tag-header">
                  <span class="skill-name">{s.name}</span>
                  <span class="skill-pct mono">{s.pct}%</span>
                </div>
                <div class="skill-bar">
                  <div class="skill-bar-fill"></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .skill-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    overflow: hidden;
    transition: all var(--transition-slow);
  }

  .skill-card:hover {
    border-color: color-mix(in srgb, var(--cat-color) 30%, transparent);
    background: var(--bg-card-hover);
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2), 0 0 30px color-mix(in srgb, var(--cat-color) 6%, transparent);
  }

  .skill-card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cat-color);
    opacity: 0;
    transform: scaleX(0);
    transition: all var(--transition-slow);
    box-shadow: 0 0 12px var(--cat-color);
  }

  .skill-card:hover .skill-card-glow {
    opacity: 0.8;
    transform: scaleX(1);
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.4rem;
  }

  .cat-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cat-color);
    background: color-mix(in srgb, var(--cat-color) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color) 12%, transparent);
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .cat-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg-primary);
    line-height: 1.2;
  }

  .cat-count {
    font-size: 0.72rem;
    color: var(--fg-muted);
    font-weight: 400;
  }

  .skill-tags {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skill-tag {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-left: 2px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: all var(--transition-fast);
    padding: 0.65rem 0.85rem;
  }

  .skill-tag:hover {
    border-color: color-mix(in srgb, var(--cat-color) 20%, transparent);
    border-left-color: var(--cat-color);
    background: rgba(255, 255, 255, 0.035);
  }

  .skill-tag-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.45rem;
    gap: 0.5rem;
  }

  .skill-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--fg-primary);
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  .skill-pct {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--cat-color);
    font-family: var(--font-display);
    opacity: 0.9;
    flex-shrink: 0;
  }

  .skill-bar {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-bar-fill {
    width: var(--skill-pct);
    height: 100%;
    background: var(--cat-color);
    border-radius: 3px;
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .skill-tag:hover .skill-bar-fill {
    box-shadow: 0 0 10px color-mix(in srgb, var(--cat-color) 35%, transparent);
  }

  @media (max-width: 640px) {
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>
