---
const categories = [
  {
    name: "skills.langs",
    nameDefault: "Lenguajes",
    color: "var(--accent)",
    icon: "{ }",
    skills: [
      { name: "Java",        pct: 88 },
      { name: "Kotlin",      pct: 82 },
      { name: "JavaScript",  pct: 90 },
      { name: "Python",      pct: 72 },
      { name: "TypeScript",  pct: 68 },
    ],
  },
  {
    name: "skills.frameworks",
    nameDefault: "Frameworks & Libs",
    color: "var(--accent2)",
    icon: "</>",
    skills: [
      { name: "Astro",       pct: 80 },
      { name: "React",       pct: 70 },
      { name: "Next.js",     pct: 65 },
      { name: "Node.js",     pct: 78 },
      { name: "Django",      pct: 60 },
    ],
  },
  {
    name: "skills.databases",
    nameDefault: "Bases de datos",
    color: "var(--accent3)",
    icon: "=/",
    skills: [
      { name: "MySQL",       pct: 80 },
      { name: "PostgreSQL",  pct: 70 },
      { name: "MongoDB",     pct: 60 },
      { name: "Supabase",    pct: 65 },
      { name: "SQLite",      pct: 75 },
    ],
  },
  {
    name: "skills.tools",
    nameDefault: "Herramientas",
    color: "#4ade80",
    icon: "⚙",
    skills: [
      { name: "Git",           pct: 88 },
      { name: "GitHub",        pct: 88 },
      { name: "Vercel",        pct: 75 },
      { name: "GitHub Actions", pct: 70 },
      { name: "IntelliJ IDEA", pct: 82 },
    ],
  },
];
---

<section id="skills">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="skills.label">Habilidades</span>
      <h2 class="section-title">
        <span data-i18n="skills.title">Mi stack</span> <span class="gradient-text" data-i18n="skills.title.hl">tecnológico</span>
      </h2>
      <p class="section-desc" data-i18n="skills.desc">Tecnologías y herramientas que domino para construir soluciones completas de extremo a extremo.</p>
    </div>

    <div class="skills-grid reveal-stagger">
      {categories.map((cat) => (
        <div class="skill-card" style={`--cat-color: ${cat.color}`}>
          <div class="skill-card-top-bar"></div>
          <div class="skill-card-header">
            <span class="cat-icon mono">{cat.icon}</span>
            <h3 class="cat-name" data-i18n={cat.name}>{cat.nameDefault}</h3>
          </div>
          <div class="skill-bars">
            {cat.skills.map((s) => (
              <div class="skill-row">
                <div class="skill-meta">
                  <span class="skill-name">{s.name}</span>
                  <span class="skill-pct mono">{s.pct}%</span>
                </div>
                <div class="skill-bar-track">
                  <div class="skill-bar-fill" style={`width: ${s.pct}%; background: ${cat.color}`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.25rem;
  }

  .skill-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
  }

  .skill-card-top-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--cat-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s;
    border-radius: 1px;
  }

  .skill-card:hover .skill-card-top-bar { transform: scaleX(1); }

  .skill-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.4rem;
  }

  .cat-icon {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cat-color);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-xs);
    letter-spacing: 0.02em;
  }

  .cat-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .skill-bars { display: flex; flex-direction: column; gap: 0.9rem; }

  .skill-row {}

  .skill-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .skill-name { font-size: 0.84rem; font-weight: 500; color: var(--text-secondary); }
  .skill-pct { font-size: 0.72rem; font-weight: 600; color: var(--cat-color); opacity: 0.9; }

  .skill-bar-track {
    height: 5px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-bar-fill {
    height: 100%;
    border-radius: 3px;
    opacity: 0.85;
    transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (max-width: 640px) { .skills-grid { grid-template-columns: 1fr; } }
</style>
