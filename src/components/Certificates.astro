---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const certs = [
  {
    title: "HTML desde Cero",
    issuer: "Academia Midudev",
    file: `${base}/certificates/html-desde-cero-midudev.pdf`,
    color: "#e44d26",
    color2: "#f16529",
    icon: "HTML5",
    year: "2025",
  },
  {
    title: "CSS desde Cero",
    issuer: "Academia Midudev",
    file: `${base}/certificates/css-desde-cero-midudev.pdf`,
    color: "#264de4",
    color2: "#2965f1",
    icon: "CSS3",
    year: "2025",
  },
  {
    title: "Introducción a la IA para Developers",
    issuer: "Academia Midudev",
    file: `${base}/certificates/introduccion-ia-midudev.pdf`,
    color: "#7c3aed",
    color2: "#a855f7",
    icon: "AI",
    year: "2025",
  },
  {
    title: "Curso Práctico de Django",
    issuer: "Udemy",
    file: `${base}/certificates/curso-practico-django.pdf`,
    color: "#092e20",
    color2: "#44b78b",
    icon: "PY",
    year: "2025",
  },
];
---

<section id="certificates">
  <div class="container">
    <div class="reveal">
      <span class="section-label">Certificados</span>
      <h2 class="section-title">Formación <span class="gradient-text">acreditada</span></h2>
      <p class="section-desc">Certificaciones oficiales que validan mis conocimientos. Haz clic para ver el certificado completo.</p>
    </div>
    <div class="certs-grid">
      {certs.map((cert, i) => (
        <div class="cert-wrapper reveal" style={`transition-delay: ${0.08 * i}s;`}>
          <button class="cert-card" data-pdf={cert.file} data-title={cert.title}>
            <div class="cert-visual" style={`background: linear-gradient(135deg, ${cert.color}, ${cert.color2})`}>
              <div class="cert-visual-shimmer"></div>
              <span class="cert-badge">{cert.year}</span>
              <div class="cert-monogram">{cert.icon}</div>
              <div class="cert-pdf-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="1.2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
              </div>
            </div>
            <div class="cert-info">
              <div>
                <h3 class="cert-title">{cert.title}</h3>
                <p class="cert-issuer">{cert.issuer}</p>
              </div>
              <div class="cert-action-row">
                <span class="cert-view">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  Ver certificado
                </span>
                <span class="cert-dl">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </span>
              </div>
            </div>
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<div id="pdf-modal" class="modal">
  <div class="modal-backdrop"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="modal-title">Certificado</h3>
      <div class="modal-actions">
        <a id="modal-download" href="#" target="_blank" rel="noopener noreferrer" class="modal-btn" title="Descargar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
        <button id="modal-close" class="modal-btn" title="Cerrar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
    <div class="modal-body">
      <iframe id="pdf-frame" src="" title="Vista previa del certificado" style="border:0"></iframe>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("pdf-modal")!;
  const frame = document.getElementById("pdf-frame") as HTMLIFrameElement;
  const titleEl = document.getElementById("modal-title")!;
  const downloadLink = document.getElementById("modal-download") as HTMLAnchorElement;
  const closeBtn = document.getElementById("modal-close")!;
  const backdrop = document.querySelector(".modal-backdrop")!;

  document.querySelectorAll(".cert-card").forEach((card) => {
    card.addEventListener("click", () => {
      const el = card as HTMLElement;
      frame.src = el.dataset.pdf!;
      titleEl.textContent = el.dataset.title!;
      downloadLink.href = el.dataset.pdf!;
      modal.classList.add("open");
      document.body.style.overflow = "hidden";
    });
  });

  const closeModal = () => {
    modal.classList.remove("open");
    document.body.style.overflow = "";
    setTimeout(() => { frame.src = ""; }, 400);
  };

  closeBtn.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
</script>

<style>
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .cert-card {
    width: 100%;
    text-align: left;
    cursor: pointer;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: all 0.4s;
    padding: 0;
    font: inherit;
    color: inherit;
    display: block;
  }

  .cert-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-hover);
    box-shadow: 0 16px 48px rgba(56, 189, 248, 0.1);
  }

  /* Visual top */
  .cert-visual {
    height: 130px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cert-visual-shimmer {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.12) 0%, transparent 60%);
  }

  .cert-badge {
    position: absolute;
    top: 12px; right: 12px;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(0,0,0,0.3);
    color: rgba(255,255,255,0.9);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    backdrop-filter: blur(6px);
    letter-spacing: 0.05em;
    font-family: 'JetBrains Mono', monospace;
  }

  .cert-monogram {
    position: absolute;
    bottom: -4px; left: 14px;
    font-size: 4rem;
    font-weight: 900;
    color: rgba(255,255,255,0.08);
    line-height: 1;
    font-family: 'JetBrains Mono', monospace;
    pointer-events: none;
    user-select: none;
  }

  .cert-pdf-icon {
    position: relative;
    z-index: 1;
    transform: scale(1);
    transition: transform 0.4s;
  }

  .cert-card:hover .cert-pdf-icon { transform: scale(1.1) rotate(-8deg); }

  /* Info */
  .cert-info {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cert-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .cert-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .cert-view {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    transition: gap 0.3s;
  }

  .cert-card:hover .cert-view { gap: 0.6rem; }

  .cert-dl {
    color: var(--text-muted);
    transition: color 0.3s;
    display: flex;
  }

  .cert-card:hover .cert-dl { color: var(--accent); }

  /* Modal */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    padding: 1rem;
  }

  .modal.open { opacity: 1; pointer-events: all; }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 900px;
    height: 85vh;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(16px);
    transition: transform 0.3s;
  }

  .modal.open .modal-content { transform: scale(1) translateY(0); }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .modal-header h3 { font-size: 0.95rem; font-weight: 600; }

  .modal-actions { display: flex; gap: 0.5rem; }

  .modal-btn {
    width: 34px; height: 34px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    text-decoration: none;
  }

  .modal-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(56, 189, 248, 0.08);
  }

  .modal-body { flex: 1; min-height: 0; }

  #pdf-frame { width: 100%; height: 100%; background: white; }

  @media (max-width: 640px) {
    .certs-grid { grid-template-columns: 1fr; }
    .modal-content { height: 92vh; border-radius: var(--radius-sm); }
  }
</style>
