<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .contact-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: all 0.4s;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .card-glow--email   { background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.07), transparent 65%); }
  .card-glow--linkedin { background: radial-gradient(circle at 50% 0%, rgba(0, 119, 181, 0.07), transparent 65%); }
  .card-glow--github  { background: radial-gradient(circle at 50% 0%, rgba(129, 140, 248, 0.07), transparent 65%); }

  .contact-card:hover .card-glow { opacity: 1; }

  .contact-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s;
  }

  .contact-card--email::before   { background: linear-gradient(90deg, var(--accent), var(--accent2)); }
  .contact-card--linkedin::before { background: linear-gradient(90deg, #0077b5, #00a0dc); }
  .contact-card--github::before  { background: linear-gradient(90deg, var(--accent2), var(--accent3)); }

  .contact-card:hover::before { transform: scaleX(1); }

  .contact-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-6px);
    background: var(--bg-card-hover);
  }

  .contact-icon {
    width: 50px; height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.12);
    color: var(--accent);
    transition: all 0.3s;
  }

  .contact-card--linkedin .contact-icon { background: rgba(0, 119, 181, 0.08); border-color: rgba(0, 119, 181, 0.12); color: #0ea5e9; }
  .contact-card--github .contact-icon   { background: rgba(129, 140, 248, 0.08); border-color: rgba(129, 140, 248, 0.12); color: var(--accent2); }

  .contact-card:hover .contact-icon { transform: scale(1.08); }

  .contact-text { flex: 1; }

  .contact-text h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    color: var(--text);
  }

  .contact-text p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    font-weight: 400;
  }

  .contact-arrow {
    color: var(--text-muted);
    transition: all 0.3s;
    align-self: flex-end;
    display: flex;
  }

  .contact-card:hover .contact-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* Footer invite */
  .contact-footer {
    text-align: center;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .contact-footer p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .footer-email {
    color: var(--accent);
    font-weight: 600;
    transition: color 0.3s;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(56, 189, 248, 0.35);
  }

  .footer-email:hover { color: var(--accent-hover); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
