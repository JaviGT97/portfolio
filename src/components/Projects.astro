    titleES: "AnalizadorCV",
    titleEN: "AnalizadorCV",
    descES: "Analizador de CVs con scoring ATS, detección de habilidades y matching con ofertas de trabajo. Soporta PDFs.",
    descEN: "CV analyzer with ATS scoring, skill detection and job offer matching. Supports PDFs.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/AnalizadorCV",
    demo: "https://javigt97.github.io/AnalizadorCV/",
    featured: true,
    gradient: "135deg, #7c5cff, #b886ff",
  },
  {
    titleES: "ContratoAlquiler",
    titleEN: "ContratoAlquiler",
    descES: "Editor interactivo de contratos de alquiler con 4 tipos de contrato y generación automatizada de PDF.",
    descEN: "Interactive rental contract editor with 4 contract types and automated PDF generation.",
    tech: ["Astro", "JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/ContratoAlquiler",
    demo: "https://javigt97.github.io/ContratoAlquiler/",
    featured: true,
    gradient: "135deg, #b886ff, #00d4aa",
  },
  {
    titleES: "GeneradorPDF",
    titleEN: "GeneradorPDF",
    descES: "API REST para generar PDFs a partir de plantillas HTML con datos JSON. Demo interactiva con 3 plantillas.",
    descEN: "REST API to generate PDFs from HTML templates with JSON data. Interactive demo with 3 templates.",
    tech: ["Node.js", "JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/GeneradorPDF",
    demo: "https://generadorpdf-y47f.onrender.com/",
    featured: true,
    gradient: "135deg, #00d4aa, #7c5cff",
  },
  {
    titleES: "Tu Peluquero",
    titleEN: "Tu Peluquero",
    descES: "App de gestión para barberías con reservas online, panel de administración y gestión de servicios.",
    descEN: "Barbershop management app with online booking, admin panel and service management.",
    tech: ["JavaScript", "Next.js"],
    github: "https://github.com/JaviGT97/Tu_Peluquero",
    featured: true,
    gradient: "135deg, #ff6b4a, #b886ff",
  },
  {
    titleES: "Punto de Venta",
    titleEN: "Point of Sale",
    descES: "Sistema POS multiplataforma en Kotlin para gestión de inventario, ventas y clientes en comercios.",
    descEN: "Cross-platform Kotlin POS system for inventory, sales and customer management.",
    tech: ["Kotlin"],
    github: "https://github.com/JaviGT97/Punto_Venta",
    featured: true,
    gradient: "135deg, #b886ff, #ff6b4a",
  },
  {
    titleES: "MazaBurguers Gourmet",
    titleEN: "MazaBurguers Gourmet",
    descES: "Web corporativa para restaurante con diseño moderno, carta digital y sección de reservas.",
    descEN: "Corporate restaurant website with modern design, digital menu and reservation section.",
    tech: ["HTML", "CSS"],
    github: "https://github.com/JaviGT97/Proyecto-MazaBurguers",
    demo: "https://javigt97.github.io/Proyecto-MazaBurguers/",
    featured: false,
    gradient: "135deg, #7c5cff, #00d4aa",
  },
  {
    titleES: "WEB-BAR",
    titleEN: "WEB-BAR",
    descES: "Página web informativa para negocio local con presencia online optimizada.",
    descEN: "Informational website for a local business with optimised online presence.",
    tech: ["HTML", "CSS"],
    github: "https://github.com/JaviGT97/WEB-BAR",
    featured: false,
    gradient: "135deg, #00d4aa, #b886ff",
  },
  {
    titleES: "Juego del Ahorcado",
    titleEN: "Hangman Game",
    descES: "Implementación del clásico juego del ahorcado en Java con interfaz de terminal interactiva.",
    descEN: "Classic hangman game implementation in Java with interactive terminal interface.",
    tech: ["Java"],
    github: "https://github.com/JaviGT97/java-juego-ahorcado",
    featured: false,
    gradient: "135deg, #b886ff, #7c5cff",
  },
  {
    titleES: "Tarea Online 4",
    titleEN: "Online Task 4",
    descES: "Proyecto de diseño de interfaces modernas con despliegue continuo vía GitHub Actions.",
    descEN: "Modern interface design project with continuous deployment via GitHub Actions.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/TareaOnline4",
    demo: "https://javigt97.github.io/TareaOnline4/",
    featured: false,
    gradient: "135deg, #ff6b4a, #7c5cff",
  },
  {
    titleES: "Curso Python IBM",
    titleEN: "IBM Python Course",
    descES: "Proyectos y ejercicios completados del programa de formación oficial de IBM en Python.",
    descEN: "Completed projects and exercises from IBM's official Python training programme.",
    tech: ["Python", "HTML"],
    github: "https://github.com/JaviGT97/Curso-Python-IBM",
    featured: false,
    gradient: "135deg, #7c5cff, #ff6b4a",
  },
];

const allTech = [...new Set(projects.flatMap((p) => p.tech))].sort();
---

<section id="proyectos">
  <div class="container">
    <div class="reveal">
      <span class="section-label" data-i18n="projects.label">Proyectos</span>
      <h2 class="section-title">
        <span data-i18n="projects.title">Trabajos</span> <span class="gradient-text" data-i18n="projects.title.hl">destacados</span>
      </h2>
      <p class="section-desc" data-i18n="projects.desc">Proyectos reales construidos con código abierto. Filtra por tecnología o explóralos todos.</p>
    </div>

    <div class="filters reveal">
      <button class="filter-btn active" data-filter="all" data-i18n="projects.filter.all">Todos</button>
      {allTech.map((t) => <button class="filter-btn" data-filter={t}>{t}</button>)}
    </div>

    <div class="projects-grid" id="projects-grid">
      {projects.map((p, i) => (
        <article class={`project-card reveal ${p.featured ? 'project-card--featured' : ''}`} data-tech={p.tech.join(",")} style={`transition-delay: ${0.06 * i}s;`}>
          <div class="card-visual" style={`background: linear-gradient(${p.gradient})`}>
            <div class="card-visual-shimmer"></div>
            <div class="card-visual-noise"></div>
            {p.featured && <span class="featured-chip">★ Destacado</span>}
            <div class="card-visual-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.5"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
            </div>
          </div>
          <div class="card-body">
            <h3 class="card-title" data-title-es={p.titleES} data-title-en={p.titleEN}>{p.titleES}</h3>
            <p class="card-desc" data-desc-es={p.descES} data-desc-en={p.descEN}>{p.descES}</p>
            <div class="card-tech">
              {p.tech.map((t) => <span class="tech-pill">{t}</span>)}
            </div>
            <div class="card-links">
              <a href={p.github} target="_blank" rel="noopener noreferrer" class="card-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                <span data-i18n="projects.code">Código</span>
              </a>
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener noreferrer" class="card-link card-link--demo">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  <span data-i18n="projects.demo">Ver demo</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Filter
  const filterBtns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const filter = (btn as HTMLElement).dataset.filter;
      cards.forEach((card) => {
        const techData = (card as HTMLElement).dataset.tech ?? "";
        if (filter === "all" || techData.includes(filter!)) {
          (card as HTMLElement).style.display = "";
          requestAnimationFrame(() => ((card as HTMLElement).style.opacity = "1"));
        } else {
          (card as HTMLElement).style.opacity = "0";
          setTimeout(() => ((card as HTMLElement).style.display = "none"), 300);
        }
      });
    });
  });

  // 3D tilt on hover
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    cards.forEach((card) => {
      const el = card as HTMLElement;
      el.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -4;
        const rotateY = ((x - centerX) / centerX) * 4;
        el.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
      });
    });
  }

  // i18n
  function applyProjectLang(lang: string) {
    document.querySelectorAll(".card-title[data-title-es]").forEach((el) => {
      const h = el as HTMLElement;
      h.textContent = lang === "en" ? (h.dataset.titleEn || h.dataset.titleEs || "") : (h.dataset.titleEs || "");
    });
    document.querySelectorAll(".card-desc[data-desc-es]").forEach((el) => {
      const d = el as HTMLElement;
      d.textContent = lang === "en" ? (d.dataset.descEn || d.dataset.descEs || "") : (d.dataset.descEs || "");
    });
  }
  window.addEventListener("langchange", (e: Event) => applyProjectLang((e as CustomEvent).detail.lang));
  document.addEventListener("DOMContentLoaded", () => applyProjectLang(localStorage.getItem("lang") || "es"));
</script>

<style>
  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.5rem 1.2rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-default);
    color: var(--fg-muted);
    cursor: pointer;
    transition: all var(--transition-base);
    font-family: inherit;
  }

  .filter-btn:hover { border-color: var(--accent-primary); color: var(--fg-primary); }
  .filter-btn.active {
    background: rgba(0, 212, 170, 0.12);
    border-color: rgba(0, 212, 170, 0.3);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    background: var(--bg-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    opacity: 1;
    transition: opacity 0.3s, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s, box-shadow 0.4s;
    will-change: transform;
  }

  .project-card:hover {
    border-color: var(--border-accent);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25), 0 0 40px rgba(0, 212, 170, 0.06);
  }

  .project-card--featured {
    grid-column: span 1;
  }

  @media (min-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .project-card--featured:first-child,
    .project-card--featured:nth-child(2) {
      grid-column: span 1;
    }
  }

  .card-visual {
    height: 140px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .card-visual-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.08) 45%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.08) 55%, transparent 60%);
    transform: translateX(-100%);
    transition: transform 0.7s ease;
  }

  .project-card:hover .card-visual-shimmer { transform: translateX(100%); }

  .card-visual-noise {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .card-visual-icon {
    position: relative;
    z-index: 1;
    transform: scale(1);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card:hover .card-visual-icon { transform: scale(1.15) rotate(-5deg); }

  .featured-chip {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.4);
    color: white;
    backdrop-filter: blur(8px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    z-index: 2;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--fg-primary);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--fg-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tech-pill {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-full);
    background: rgba(0, 212, 170, 0.08);
    color: var(--fg-muted);
    border: 1px solid rgba(0, 212, 170, 0.12);
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  .card-links {
    display: flex;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--fg-muted);
    transition: color var(--transition-fast);
  }

  .card-link:hover { color: var(--accent-primary); }
  .card-link--demo { color: var(--accent-primary); }
  .card-link--demo:hover { color: var(--accent-secondary); }

  @media (max-width: 640px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
