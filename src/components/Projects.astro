---
const projects = [
  {
    title: "AnalizadorCV",
    desc: "Analizador de CVs con scoring ATS, detección de habilidades y matching con ofertas de trabajo. Soporta PDFs.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/AnalizadorCV",
    demo: "https://javigt97.github.io/AnalizadorCV/",
    featured: true,
    gradient: "135deg, #38bdf8, #818cf8",
  },
  {
    title: "ContratoAlquiler",
    desc: "Editor interactivo de contratos de alquiler con 4 tipos de contrato y generación automatizada de PDF.",
    tech: ["Astro", "JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/ContratoAlquiler",
    demo: "https://javigt97.github.io/ContratoAlquiler/",
    featured: true,
    gradient: "135deg, #818cf8, #f472b6",
  },
  {
    title: "GeneradorPDF",
    desc: "API REST para generar PDFs profesionales a partir de plantillas HTML con datos JSON. Demo interactiva con 3 plantillas.",
    tech: ["Node.js", "JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/GeneradorPDF",
    demo: "https://generadorpdf-y47f.onrender.com/",
    featured: true,
    gradient: "135deg, #4ade80, #38bdf8",
  },
  {
    title: "Tu Peluquero",
    desc: "App de gestión para barberías con sistema de reservas online, panel de administración y gestión de servicios.",
    tech: ["JavaScript", "Next.js"],
    github: "https://github.com/JaviGT97/Tu_Peluquero",
    featured: true,
    gradient: "135deg, #f472b6, #818cf8",
  },
  {
    title: "Punto de Venta",
    desc: "Sistema POS multiplataforma en Kotlin para gestión de inventario, ventas y clientes en comercios.",
    tech: ["Kotlin"],
    github: "https://github.com/JaviGT97/Punto_Venta",
    featured: true,
    gradient: "135deg, #fb923c, #f472b6",
  },
  {
    title: "MazaBurguers Gourmet",
    desc: "Web corporativa profesional para restaurante con diseño moderno, carta digital y sección de reservas.",
    tech: ["HTML", "CSS"],
    github: "https://github.com/JaviGT97/Proyecto-MazaBurguers",
    demo: "https://javigt97.github.io/Proyecto-MazaBurguers/",
    featured: false,
    gradient: "135deg, #fbbf24, #fb923c",
  },
  {
    title: "WEB-BAR",
    desc: "Página web informativa para negocio local con presencia online optimizada.",
    tech: ["HTML", "CSS"],
    github: "https://github.com/JaviGT97/WEB-BAR",
    featured: false,
    gradient: "135deg, #38bdf8, #4ade80",
  },
  {
    title: "Juego del Ahorcado",
    desc: "Implementación del clásico juego del ahorcado en Java con interfaz de terminal interactiva.",
    tech: ["Java"],
    github: "https://github.com/JaviGT97/java-juego-ahorcado",
    featured: false,
    gradient: "135deg, #818cf8, #38bdf8",
  },
  {
    title: "Tarea Online 4",
    desc: "Proyecto de diseño de interfaces modernas con despliegue continuo vía GitHub Actions.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/TareaOnline4",
    demo: "https://javigt97.github.io/TareaOnline4/",
    featured: false,
    gradient: "135deg, #f472b6, #fbbf24",
  },
  {
    title: "Curso Python IBM",
    desc: "Proyectos y ejercicios completados del programa de formación oficial de IBM en Python.",
    tech: ["Python", "HTML"],
    github: "https://github.com/JaviGT97/Curso-Python-IBM",
    featured: false,
    gradient: "135deg, #4ade80, #818cf8",
  },
];

const allTech = [...new Set(projects.flatMap((p) => p.tech))].sort();
---

<section id="projects">
  <div class="container">
    <div class="reveal">
      <span class="section-label">Proyectos</span>
      <h2 class="section-title">Trabajos <span class="gradient-text">destacados</span></h2>
      <p class="section-desc">Proyectos reales construidos con código abierto. Filtra por tecnología o explóralos todos.</p>
    </div>

    <div class="filters reveal">
      <button class="filter-btn active" data-filter="all">Todos</button>
      {allTech.map((t) => <button class="filter-btn" data-filter={t}>{t}</button>)}
    </div>

    <div class="projects-grid reveal-stagger" id="projects-grid">
      {projects.map((p) => (
        <article class="project-card" data-tech={p.tech.join(",")}>
          <div class="card-header-bar" style={`background: linear-gradient(${p.gradient})`}>
            <div class="card-header-shimmer"></div>
            {p.featured && <span class="featured-chip">★ Destacado</span>}
          </div>
          <div class="card-body">
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.desc}</p>
            <div class="card-tech">
              {p.tech.map((t) => <span class="tech-tag mono">{t}</span>)}
            </div>
            <div class="card-links">
              <a href={p.github} target="_blank" rel="noopener noreferrer" class="card-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                Código
              </a>
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener noreferrer" class="card-link card-link--demo">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Ver demo
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const filter = (btn as HTMLElement).dataset.filter;
      cards.forEach((card) => {
        const techData = (card as HTMLElement).dataset.tech ?? "";
        if (filter === "all" || techData.includes(filter!)) {
          (card as HTMLElement).style.display = "flex";
          setTimeout(() => ((card as HTMLElement).style.opacity = "1"), 10);
        } else {
          (card as HTMLElement).style.opacity = "0";
          setTimeout(() => ((card as HTMLElement).style.display = "none"), 300);
        }
      });
    });
  });
</script>

<style>
  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.45rem 1.1rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
  }

  .filter-btn:hover { border-color: var(--accent); color: var(--text); }

  .filter-btn.active {
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.3);
    color: var(--accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    opacity: 1;
    transition: opacity 0.3s, transform 0.4s, border-color 0.4s, box-shadow 0.4s;
  }

  .project-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(56, 189, 248, 0.08);
  }

  /* Color header bar */
  .card-header-bar {
    height: 5px;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .card-header-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transform: translateX(-100%);
    transition: transform 0.5s ease;
  }

  .project-card:hover .card-header-shimmer { transform: translateX(100%); }

  .featured-chip {
    position: absolute;
    top: 8px;
    right: 12px;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: rgba(0,0,0,0.35);
    color: white;
    backdrop-filter: blur(4px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-body {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tech-tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    background: rgba(56, 189, 248, 0.06);
    color: var(--text-muted);
    border: 1px solid rgba(56, 189, 248, 0.1);
  }

  .card-links {
    display: flex;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .card-link:hover { color: var(--accent); }
  .card-link--demo { color: var(--accent); }
  .card-link--demo:hover { color: var(--accent-hover); }

  @media (max-width: 640px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
