---
const projects = [
  {
    title: "Tu Peluquero",
    desc: "App para gestión de barberías con sistema de reservas y administración de servicios.",
    tech: ["JavaScript"],
    github: "https://github.com/JaviGT97/Tu_Peluquero",
    featured: true,
  },
  {
    title: "Punto de Venta",
    desc: "Sistema POS multiplataforma en Kotlin para gestión de comercios y ventas.",
    tech: ["Kotlin"],
    github: "https://github.com/JaviGT97/Punto_Venta",
    featured: true,
  },
  {
    title: "MazaBurguers Gourmet",
    desc: "Web corporativa profesional para restaurante con diseño de interfaces moderno.",
    tech: ["CSS", "HTML"],
    github: "https://github.com/JaviGT97/Proyecto-MazaBurguers",
    demo: "https://javigt97.github.io/Proyecto-MazaBurguers/",
    featured: true,
  },
  {
    title: "WEB-BAR",
    desc: "Página web informativa para negocio local con presencia online.",
    tech: ["HTML", "CSS"],
    github: "https://github.com/JaviGT97/WEB-BAR",
    featured: false,
  },
  {
    title: "Juego del Ahorcado",
    desc: "Clásico juego implementado en Java con interfaz de terminal interactiva.",
    tech: ["Java"],
    github: "https://github.com/JaviGT97/java-juego-ahorcado",
    featured: false,
  },
  {
    title: "Curso Python IBM",
    desc: "Ejercicios y proyectos del programa de formación de IBM en Python.",
    tech: ["Python", "HTML"],
    github: "https://github.com/JaviGT97/Curso-Python-IBM",
    featured: false,
  },
  {
    title: "Tarea Online 4",
    desc: "Proyecto de diseño de interfaces con despliegue continuo en GitHub Pages.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/TareaOnline4",
    demo: "https://javigt97.github.io/TareaOnline4/",
    featured: false,
  },
  {
    title: "AnalizadorCV",
    desc: "Analizador de currículums con puntuación ATS, detección de habilidades, matching con ofertas y soporte para PDF.",
    tech: ["JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/AnalizadorCV",
    demo: "https://javigt97.github.io/AnalizadorCV/",
    featured: true,
  },
  {
    title: "GeneradorPDF",
    desc: "API REST para generar PDFs profesionales desde plantillas HTML con datos JSON. Incluye demo interactiva con 3 plantillas.",
    tech: ["Node.js", "JavaScript", "HTML", "CSS"],
    github: "https://github.com/JaviGT97/GeneradorPDF",
    featured: true,
  },
];

const allTech = [...new Set(projects.flatMap((p) => p.tech))].sort();
---

<section id="projects">
  <div class="container">
    <div class="reveal">
      <span class="section-label">Proyectos</span>
      <h2 class="section-title">Trabajos <span class="gradient-text">destacados</span></h2>
      <p class="section-desc">Aquí puedes ver algunos de los proyectos en los que he trabajado. Todos con código abierto en GitHub.</p>
    </div>
    <div class="filters reveal">
      <button class="filter-btn active" data-filter="all">Todos</button>
      {allTech.map((t) => <button class="filter-btn" data-filter={t}>{t}</button>)}
    </div>
    <div class="projects-grid reveal-stagger" id="projects-grid">
      {projects.map((p) => (
        <article class="project-card" data-tech={p.tech.join(",")}>
          <div class="card-glow"></div>
          <div class="card-bg-pattern"></div>
          <div class="card-content">
            <div class="card-header">
              <div class="card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              </div>
              {p.featured && <span class="featured-badge">Destacado</span>}
            </div>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.desc}</p>
            <div class="card-tech">
              {p.tech.map((t) => <span class="tech-tag">{t}</span>)}
            </div>
            <div class="card-links">
              <a href={p.github} target="_blank" rel="noopener noreferrer" class="card-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                Código
              </a>
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener noreferrer" class="card-link demo-link">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Demo
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        if (filter === "all" || card.dataset.tech.includes(filter)) {
          card.style.display = "flex";
          setTimeout(() => card.style.opacity = "1", 10);
        } else {
          card.style.opacity = "0";
          setTimeout(() => card.style.display = "none", 300);
        }
      });
    });
  });
</script>

<style>
  .filters {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 500;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.3s;
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, rgba(108, 108, 240, 0.15), rgba(168, 85, 247, 0.15));
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
    transition: all 0.4s;
    display: flex;
    flex-direction: column;
    opacity: 1;
    transition: opacity 0.3s, transform 0.4s, border-color 0.4s;
  }

  .project-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-6px);
    background: var(--bg-card-hover);
  }

  .card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 50% 0%, var(--accent-glow) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .project-card:hover .card-glow {
    opacity: 1;
  }

  .card-content {
    position: relative;
    z-index: 1;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .card-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(108, 108, 240, 0.1), rgba(168, 85, 247, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .featured-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    background: linear-gradient(135deg, rgba(108, 108, 240, 0.15), rgba(168, 85, 247, 0.15));
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tech-tag {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .card-links {
    display: flex;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .card-link:hover { color: var(--accent); }
  .demo-link { color: var(--accent); }
  .demo-link:hover { color: var(--accent-hover); }

  @media (max-width: 640px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
